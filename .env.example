# Публічна HTTPS-адреса сайту після перенесення з GitHub Pages
PUBLIC_URL=https://example.com

# Додаються лише в секретні змінні хостингу. Не комітьте реальні ключі.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Довгий випадковий секрет для входу на /admin (мінімум 32 символи)
ADMIN_TOKEN=

# Необов'язково: шлях до постійного диска на хостингу
DB_PATH=./data/bookings.db

PORT=3000
